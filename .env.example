# Copie este archivo como .env y ajuste los valores. El archivo .env no se versiona.

# Base de datos (docker-compose)
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=reservas

# Seguridad: genere un secreto aleatorio, por ejemplo con `openssl rand -base64 48`
JWT_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-32-bytes
JWT_EXPIRATION=30m
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m

# URL pública usada en el enlace de verificación y orígenes CORS permitidos (separados por coma)
APP_BASE_URL=http://localhost:8081
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Puertos del host
DB_HOST_PORT=5433
APP_HOST_PORT=8081
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Solo si ejecuta la aplicación fuera de Compose sin el perfil dev (p. ej. despliegue):
# DB_URL=jdbc:postgresql://host:5432/reservas
# DB_USERNAME=reservas
# DB_PASSWORD=
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# APP_MAIL_FROM=no-reply@example.com
# SWAGGER_ENABLED=true
