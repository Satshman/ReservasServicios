{
  "name": "reservaya-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend MVP de ReservaYa (React + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
