# Plantilla de variables de entorno del frontend.
# Este archivo debe versionarse como `.env.example`:
#   mv frontend/env.example frontend/.env.example
# Para usarlo en local:
#   cp frontend/.env.example frontend/.env

# URL base de la API de ReservaYa (incluye el prefijo de versión /api/v1).
# Si no se define, la aplicación usa el backend desplegado en Render.
VITE_API_URL=https://reservaya-vvke.onrender.com/api/v1

# Para trabajar contra un backend local levantado con podman-compose:
# VITE_API_URL=http://localhost:8081/api/v1
