    {
      "type": "timeseries",
      "title": "Reservas creadas y canceladas",
      "description": "HU-07 / HU-08 / HU-15. Sale de la métrica HTTP: una reserva creada es un POST /reservas con 201.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
