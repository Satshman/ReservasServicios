      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"reservas-servicios\", method=\"POST\", uri=\"/api/v1/reservas\", status=\"201\"}[$__rate_interval]))",
          "legendFormat": "Creadas"
