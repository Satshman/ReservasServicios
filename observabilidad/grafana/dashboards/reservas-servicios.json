      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"reservas-servicios\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"reservas-servicios\", uri!~\"/actuator.*\"}[5m])), 1e-9)",
          "instant": false
        }
      ]
