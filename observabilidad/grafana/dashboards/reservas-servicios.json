        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"reservas-servicios\", method=\"POST\", uri=\"/api/v1/reservas/{idReserva}/cancelacion\", status=\"200\"}[$__rate_interval]))",
          "legendFormat": "Canceladas"
